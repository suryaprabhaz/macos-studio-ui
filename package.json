{
  "name": "macos-studio-ui",
  "displayName": "macOS Studio UI \u2014 Native macOS Experience for Code Editors",
  "description": "Transform VS Code, Cursor, Windsurf, and Code OSS into a refined, native macOS development studio with authentic palettes, typography, and controls.",
  "version": "0.1.0",
  "publisher": "rizzzuu",
  "author": {
    "name": "Rizzzuu",
    "url": "https://github.com/suryaprabhaz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suryaprabhaz/macos-studio-ui.git"
  },
  "homepage": "https://github.com/suryaprabhaz/macos-studio-ui#readme",
  "bugs": {
    "url": "https://github.com/suryaprabhaz/macos-studio-ui/issues"
  },
  "license": "MIT",
  "icon": "assets/macos-studio-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "macos",
    "apple",
    "studio",
    "theme",
    "ui",
    "cupertino",
    "cursor",
    "clean",
    "minimal"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aeroui.enable",
        "title": "macOS Studio: Enable macOS Mode",
        "category": "macOS Studio"
      },
      {
        "command": "aeroui.disable",
        "title": "macOS Studio: Disable macOS Mode",
        "category": "macOS Studio"
      },
      {
        "command": "aeroui.toggle",
        "title": "macOS Studio: Toggle macOS Mode",
        "category": "macOS Studio"
      },
      {
        "command": "aeroui.selectPreset",
        "title": "macOS Studio: Select Preset",
        "category": "macOS Studio"
      },
      {
        "command": "aeroui.openSettings",
        "title": "macOS Studio: Open macOS Studio Settings",
        "category": "macOS Studio"
      },
      {
        "command": "aeroui.restorePrevious",
        "title": "macOS Studio: Restore Previous Appearance",
        "category": "macOS Studio"
      },
      {
        "command": "aeroui.showStatus",
        "title": "macOS Studio: Show Status",
        "category": "macOS Studio"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aeroui-sidebar-view",
          "title": "macOS Studio",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "aeroui-sidebar-view": [
        {
          "type": "webview",
          "id": "aeroui.dashboardView",
          "name": "macOS Studio Control Center"
        }
      ]
    },
    "themes": [
      {
        "label": "macOS Studio macOS Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/aeroui-macos-dark.json"
      },
      {
        "label": "macOS Studio macOS Light",
        "uiTheme": "vs",
        "path": "./themes/aeroui-macos-light.json"
      },
      {
        "label": "macOS Studio macOS Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/aeroui-macos-midnight.json"
      },
      {
        "label": "macOS Studio Minimal",
        "uiTheme": "vs-dark",
        "path": "./themes/aeroui-minimal.json"
      },
      {
        "label": "macOS Studio Glass",
        "uiTheme": "vs-dark",
        "path": "./themes/aeroui-glass.json"
      },
      {
        "label": "macOS Studio Classic",
        "uiTheme": "vs-dark",
        "path": "./themes/aeroui-classic.json"
      }
    ],
    "iconThemes": [
      {
        "id": "aeroui-icons",
        "label": "AeroUI macOS Icons",
        "path": "./icons/aeroui-icons.json"
      }
    ],
    "configuration": {
      "title": "AeroUI",
      "properties": {
        "aeroui.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether AeroUI macOS mode is currently enabled."
        },
        "aeroui.activePreset": {
          "type": "string",
          "default": "macOS Dark",
          "enum": [
            "macOS Dark",
            "macOS Light",
            "macOS Midnight",
            "Minimal",
            "Glass-inspired",
            "Classic"
          ],
          "description": "Active AeroUI preset."
        },
        "aeroui.accentColor": {
          "type": "string",
          "default": "appleBlue",
          "enum": [
            "appleBlue",
            "applePurple",
            "applePink",
            "appleOrange",
            "appleGreen",
            "appleGraphite"
          ],
          "description": "macOS-inspired accent color choice."
        },
        "aeroui.enableSmoothScrolling": {
          "type": "boolean",
          "default": true,
          "description": "Enable smooth scrolling in editor and workbench."
        },
        "aeroui.enableSmoothCursor": {
          "type": "boolean",
          "default": true,
          "description": "Enable smooth cursor animation and blinking."
        },
        "aeroui.applyMacFonts": {
          "type": "boolean",
          "default": true,
          "description": "Include clean macOS typography fallback fonts in editor font family."
        },
        "aeroui.applyIconTheme": {
          "type": "boolean",
          "default": true,
          "description": "Automatically activate AeroUI macOS icon theme when applying presets."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.22.0"
  }
}